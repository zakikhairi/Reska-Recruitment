// Smart Recruitment System - Prisma Schema
// PT Reska Multi Usaha (KAI Services)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          String    @default("APPLICANT") // APPLICANT, HR_ADMIN, SUPER_ADMIN
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  applicant     Applicant?
  admin         Admin?
  passwordReset PasswordReset?
}

model Admin {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  employeeId  String    @unique
  department  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ============================================
// PASSWORD RESET
// ============================================

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  expires   DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

// ============================================
// APPLICANT PROFILE
// ============================================

model Applicant {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  nik         String    @unique
  fullName    String
  phone       String
  dateOfBirth DateTime
  placeOfBirth String
  gender      String    // MALE, FEMALE
  address     String
  city        String
  postalCode  String
  height      Float?
  weight      Float?
  education   String    // SMA, D3, S1, S2
  university  String?

  photoUrl    String?
  cvUrl       String?

  documents    Document[]
  applications Application[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Document {
  id          String    @id @default(cuid())
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  type        String    // PHOTO, CV, IJAZAH, TRANSCRIPT, CERTIFICATE, OTHER
  fileName    String
  fileUrl     String
  fileSize    Int
  uploadedAt  DateTime  @default(now())
}

// ============================================
// JOB POSTINGS
// ============================================

model JobPosting {
  id              String    @id @default(cuid())
  title           String
  division        String    // ON_TRAIN_SERVICE, RES_CLEAN, RES_PARKING, LOGISTICS, IT_STAFF, ADMIN
  location        String
  description     String
  requirements    String

  minHeight       Float?
  minEducation    String    // SMA, D3, S1, S2
  minAge          Int?
  maxAge          Int?

  status          String    @default("ACTIVE") // DRAFT, ACTIVE, CLOSED, FILLED
  deadline        DateTime

  applications    Application[]
  testConfig      TestConfig?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ============================================
// APPLICATIONS
// ============================================

model Application {
  id              String    @id @default(cuid())
  applicantId     String
  applicant       Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  jobPostingId    String
  jobPosting      JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  status          String    @default("PENDING") // PENDING, ADMIN_CHECK, TEST_SCHEDULED, IN_TEST, TEST_COMPLETED, INTERVIEW, MCU, OFFERED, ACCEPTED, REJECTED, WITHDRAWN
  notes           String?
  reviewedBy      String?
  reviewedAt      DateTime?

  testSession     TestSession?
  interview       Interview?
  mcu             MedicalCheckup?
  statusHistory   StatusHistory[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([applicantId, jobPostingId])
}

model StatusHistory {
  id            String    @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    String?
  toStatus      String
  notes         String?
  createdAt     DateTime  @default(now())
}

// ============================================
// INTERVIEW & MCU
// ============================================

model Interview {
  id            String    @id @default(cuid())
  applicationId String    @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  scheduledAt   DateTime
  location      String
  interviewer   String
  type          String    @default("RECORDING") // RECORDING, face_to_face, HYBRID
  notes         String?
  score         Int?
  result        String?   // PASSED, FAILED, RESCHEDULE

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model MedicalCheckup {
  id            String    @id @default(cuid())
  applicationId String    @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  scheduledAt   DateTime
  location      String
  result        String?   // FIT, UNFIT, CONDITIONAL
  notes         String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ============================================
// TEST CONFIGURATION
// ============================================

model TestConfig {
  id              String    @id @default(cuid())
  jobPostingId     String    @unique
  jobPosting       JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  // Categories enabled (stored as comma-separated string)
  // AKHLAK, HOSPITALITY, TECHNICAL, FACILITY, APTITUDE
  categories      String

  // JSON stored as text for SQLite
  categoryWeights String    // {"AKHLAK": 20, "HOSPITALITY": 30, ...}
  passingGrades   String    // {"AKHLAK": 60, "HOSPITALITY": 70, ...}

  overallPassingGrade Int   @default(65)

  totalDurationMinutes Int  @default(90)
  timePerQuestionSeconds Int? @default(90)

  questionsPerCategory Int  @default(10)
  shuffleQuestions     Boolean @default(true)
  shuffleAnswers       Boolean @default(true)

  allowTabSwitch      Boolean @default(false)
  maxTabSwitches      Int     @default(5)

  isActive           Boolean  @default(true)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// ============================================
// QUESTION BANK
// ============================================

model Question {
  id            String    @id @default(cuid())
  category      String    // AKHLAK, HOSPITALITY, TECHNICAL, FACILITY, APTITUDE
  jobDivision   String?   // Specific division or null for all

  stem          String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String    // A, B, C, D

  difficulty    String    @default("MEDIUM") // EASY, MEDIUM, HARD
  points        Int       @default(1)

  explanation   String?

  isActive      Boolean   @default(true)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ============================================
// TEST SESSIONS & ANSWERS
// ============================================

model TestSession {
  id            String    @id @default(cuid())
  applicationId String    @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  status        String    @default("SCHEDULED") // SCHEDULED, NOT_STARTED, IN_PROGRESS, PAUSED, SUBMITTED, SCORED, EXPIRED

  scheduledAt   DateTime? // Jadwal tes yang ditentukan admin (batch)
  startedAt     DateTime?
  submittedAt   DateTime?

  questions     String?   // JSON array of selected question IDs (shuffled)
  tabSwitchCount Int      @default(0)
  tabSwitchLogs  String? // JSON array of timestamps

  rawScores     String?   // JSON: { "category": rawScore }
  weightedScores String?   // JSON: { "category": weightedScore }
  totalScore    Int?
  passed        Boolean?

  answers       ApplicantAnswer[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ApplicantAnswer {
  id            String    @id @default(cuid())
  testSessionId String
  testSession   TestSession @relation(fields: [testSessionId], references: [id], onDelete: Cascade)
  questionId    String
  selectedAnswer String?   // A, B, C, D
  isCorrect     Boolean?
  pointsEarned  Int       @default(0)
  answeredAt    DateTime?
}
